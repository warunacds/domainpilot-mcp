{
  "name": "domainpilot-mcp",
  "version": "1.0.2",
  "description": "MCP server for Domain Pilot — manage domains, DNS, uptime monitoring through AI assistants",
  "main": "dist/index.js",
  "bin": {
    "domainpilot-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx tsx src/index.ts",
    "start:http": "node dist/http.js",
    "dev:http": "tsx src/http.ts",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "domain",
    "dns",
    "uptime",
    "monitoring",
    "domainpilot"
  ],
  "license": "MIT",
  "author": "DomainPilot",
  "homepage": "https://domainpilot.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warunacds/domainpilot-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/warunacds/domainpilot-mcp/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
